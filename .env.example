# PdfEzFill Desktop — environment template
# Copy to .env and fill in. NEVER commit .env. All values below are placeholders.

# --- License validation ---
# Remote endpoint the desktop app calls once to activate a key.
LICENSE_VALIDATION_URL=https://api.pdfezfill.com/v1/license/validate
# Local path where the activated license is stored (desktop).
LICENSE_KEY_PATH=./license.json
# Port for the local test stub (scripts/license-stub.mjs).
LICENSE_STUB_PORT=8787

# --- Stripe (WEB backend key delivery — not used by the desktop app directly) ---
# Use test keys (sk_test_...) during development; live keys only in production secrets.
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_TEST_WEBHOOK_SECRET
STRIPE_PRICE_ID_DESKTOP=price_YOUR_DESKTOP_PRICE_ID

# --- Key delivery email (web backend) ---
LICENSE_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# --- Admin ---
ADMIN_API_KEY=YOUR_ADMIN_API_KEY

# --- OpenCodeReview CI (GitHub repo secrets, not .env) ---
# OCR_LLM_URL=https://YOUR_LLM_ENDPOINT/v1
# OCR_LLM_AUTH_TOKEN=YOUR_LLM_API_TOKEN
# OCR_LLM_MODEL=YOUR_MODEL_NAME
